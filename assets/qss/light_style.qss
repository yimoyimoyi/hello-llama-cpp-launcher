/* ═══════════════════════════════════════════════════════════════
   light_style.qss — 统一亮色主题 (增强版)

   色调层次（全界面单一色系）：
     基底层  #f2f3f5   窗口/面板/标签页/卡片/滚动条/状态栏
     表面层  #ffffff   输入框/按钮/下拉框/复选框/单选框/滑块
     悬停层  #e8eaf0   按钮悬停/SpinBox箭头悬停/折叠面板悬停
     边框    #d4d6dc   所有控件统一边框色
     强调色  #3d88e0   聚焦边框/选中态/进度条/标签下划线
     成功色  #16a34a   成功状态/启动按钮
     危险色  #dc2626   错误/停止按钮
   ═══════════════════════════════════════════════════════════════ */

/* ── 窗口 ──────────────────────────────────────────────────── */
QMainWindow {
    background-color: #f2f3f5;
    color: #1e1e2e;
    font-family: 'Segoe UI', 'Microsoft YaHei', 'Noto Sans SC', sans-serif;
    font-size: 8.5pt;
}

QWidget {
    font-family: 'Segoe UI', 'Microsoft YaHei', 'Noto Sans SC', sans-serif;
}

/* ── 标签 ──────────────────────────────────────────────────── */
QLabel {
    color: #505060;
    font-size: 8pt;
    background: transparent;
}

/* ── 输入框 / 数字框 ────────────────────────────────────────── */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #1e1e2e;
    border: 1px solid #d4d6dc;
    border-radius: 5px;
    padding: 3px 6px;
    min-height: 22px;
    font-size: 8.5pt;
    selection-background-color: #c8dcf8;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #3d88e0;
    background-color: #f8faff;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #b0b8c4;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #eef0f2;
    color: #a0a0b0;
    border-color: #e0e2e6;
}

/* ── 下拉框 (Qt 6 Fusion 风格适配) ──────────────────────────── */
QComboBox {
    background-color: #ffffff;
    color: #1e1e2e;
    border: 1px solid #d4d6dc;
    border-radius: 5px;
    padding: 3px 22px 3px 6px;
    min-height: 22px;
    font-size: 8.5pt;
    selection-background-color: #c8dcf8;
}
QComboBox:focus {
    border-color: #3d88e0;
    background-color: #f8faff;
}
QComboBox:hover {
    border-color: #b0b8c4;
}
QComboBox:disabled {
    background-color: #eef0f2;
    color: #a0a0b0;
    border-color: #e0e2e6;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
    subcontrol-origin: padding;
    subcontrol-position: top right;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #707080;
    width: 0px; height: 0px;
}
/* Qt 6 下拉弹窗列表 */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1e1e2e;
    selection-background-color: #dce8f8;
    selection-color: #1e1e2e;
    outline: none;
    font-size: 8.5pt;
    border: 1px solid #c8ccd4;
    border-radius: 5px;
    padding: 2px;
}
QComboBox QAbstractItemView::item {
    padding: 4px 6px;
    min-height: 22px;
    border-radius: 3px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #eef2f8;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #dce8f8;
    color: #1e1e2e;
}

/* ── SpinBox 按钮 ──────────────────────────────────────────── */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #d4d6dc;
    border-bottom: 1px solid #d4d6dc;
    border-top-right-radius: 4px;
    background-color: #f0f2f5;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #e0e4ea;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: none; }

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-left: 1px solid #d4d6dc;
    border-bottom-right-radius: 4px;
    background-color: #f0f2f5;
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #e0e4ea;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: none; }

/* ── 按钮 ──────────────────────────────────────────────────── */
QPushButton {
    background-color: #ffffff;
    color: #1e1e2e;
    border: 1px solid #d4d6dc;
    border-radius: 5px;
    padding: 4px 10px;
    font-size: 8.5pt;
    min-height: 22px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #e8eaf0;
    border-color: #b0b8c4;
}
QPushButton:pressed {
    background-color: #dce0e8;
    border-color: #3d88e0;
}
QPushButton:disabled {
    color: #a0a0b0;
    background-color: #f4f5f7;
    border-color: #e0e2e6;
}

/* ── 复选框 ────────────────────────────────────────────────── */
QCheckBox { spacing: 6px; color: #505060; }
QCheckBox::indicator {
    width: 15px; height: 15px;
    border-radius: 3px;
    border: 1.5px solid #b8bcc4;
    background-color: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #3d88e0;
    background-color: #f0f6ff;
}
QCheckBox::indicator:checked {
    background-color: #3d88e0;
    border-color: #3d88e0;
}
QCheckBox::indicator:disabled {
    background-color: #f0f2f4;
    border-color: #e0e2e6;
}

/* ── 单选按钮 ──────────────────────────────────────────────── */
QRadioButton { spacing: 6px; color: #505060; }
QRadioButton::indicator {
    width: 13px; height: 13px;
    border-radius: 7px;
    border: 1.5px solid #b8bcc4;
    background-color: #ffffff;
}
QRadioButton::indicator:hover {
    border-color: #3d88e0;
    background-color: #f0f6ff;
}
QRadioButton::indicator:checked {
    background-color: #3d88e0;
    border-color: #3d88e0;
}

/* ── 进度条 ────────────────────────────────────────────────── */
QProgressBar {
    background-color: #e8eaf0;
    border: 1px solid #d4d6dc;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    font-size: 6pt;
    color: #707080;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #2a6ec0, stop:0.5 #3d88e0, stop:1 #2a6ec0);
    border-radius: 3px;
}

/* ── 滚动条 ────────────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: #f2f3f5;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #c4c8d0;
    border-radius: 4px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover { background-color: #a8acb8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background-color: #f2f3f5;
    height: 8px;
    border-radius: 4px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background-color: #c4c8d0;
    border-radius: 4px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover { background-color: #a8acb8; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ── 标签页 ────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #d4d6dc;
    border-radius: 6px;
    background-color: #f2f3f5;
    top: -1px;
}
QTabBar {
    background-color: transparent;
}
QTabBar::tab {
    background-color: #e8eaf0;
    color: #808898;
    border: 1px solid transparent;
    padding: 5px 14px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    font-weight: 600;
    font-size: 8.5pt;
    min-width: 60px;
}
QTabBar::tab:selected {
    background-color: #f2f3f5;
    color: #3d88e0;
    border: 1px solid #d4d6dc;
    border-bottom: 2px solid #3d88e0;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    color: #1e1e2e;
    background-color: #dce0e8;
}
QTabBar::tab:disabled {
    color: #b0b4bc;
}

/* ── 折叠面板标题栏 ────────────────────────────────────────── */
QWidget#collapsibleHeader {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #d4d6dc;
    padding: 4px 2px;
    min-height: 22px;
    border-radius: 4px;
}
QWidget#collapsibleHeader:hover {
    background-color: #e8eaf0;
}
QLabel#collapsibleTitle {
    color: #1e1e2e;
    font-weight: bold;
    font-size: 9pt;
    border: none;
    padding-left: 6px;
}
QLabel#collapsibleArrow {
    color: #3d88e0;
    border: none;
    padding-right: 6px;
    min-width: 20px;
    max-width: 20px;
    font-weight: bold;
}

/* ── 滚动区域 ──────────────────────────────────────────────── */
QScrollArea { border: none; background-color: #f2f3f5; }
QWidget#paramsContainer, QWidget#settingsContainer {
    background-color: #f2f3f5;
    color: #1e1e2e;
}

/* ── 底部操作栏 ────────────────────────────────────────────── */
QFrame#actionFrame {
    background-color: #eaecf0;
    border: none;
    border-top: 1px solid #d4d6dc;
    padding: 4px 8px;
}

/* ── 底部状态栏 ────────────────────────────────────────────── */
QFrame#statusBar {
    background-color: #e4e6ea;
    border: none;
    border-top: 1px solid #c8ccd4;
    min-height: 18px;
    padding: 2px 8px;
}
QLabel#statusLabel {
    color: #707080;
    font-size: 8pt;
}
QLabel#exeLabel {
    color: #3d88e0;
    font-size: 8pt;
    font-weight: 500;
}

/* ── 滑块 ──────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background-color: #e0e4ea;
    border: 1px solid #d4d6dc;
    border-radius: 4px;
    height: 6px;
}
QSlider::handle:horizontal {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        fx:0.5, fy:0.3, stop:0 #5a9ee0, stop:1 #3d88e0);
    border: 2px solid #2a6ec0;
    border-radius: 8px;
    width: 16px;
    height: 16px;
    margin: -6px 0;
}
QSlider::handle:horizontal:hover {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        fx:0.5, fy:0.3, stop:0 #6aaef0, stop:1 #5a9ee0);
    border-color: #3d88e0;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6aaef0, stop:1 #3d88e0);
    border-radius: 3px;
}

/* ── 工具提示 ──────────────────────────────────────────────── */
QToolTip {
    background-color: #ffffff;
    color: #1e1e2e;
    border: 1px solid #b0b8c4;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 8pt;
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
}

/* ── 列表控件 ──────────────────────────────────────────────── */
QListWidget {
    background-color: #ffffff;
    color: #1e1e2e;
    border: 1px solid #d4d6dc;
    border-radius: 5px;
    padding: 3px;
    outline: none;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 8.5pt;
}
QListWidget::item {
    padding: 3px 6px;
    border-radius: 3px;
}
QListWidget::item:selected {
    background-color: #dce8f8;
    color: #1e1e2e;
}
QListWidget::item:hover:!selected {
    background-color: #eef2f8;
}

/* ── 文本编辑 (控制台) ─────────────────────────────────────── */
QTextEdit {
    background-color: #ffffff;
    color: #1e1e2e;
    border: 1px solid #d4d6dc;
    border-radius: 6px;
    padding: 5px;
    font-family: 'Consolas', 'Courier New', monospace;
    selection-background-color: #c8dcf8;
}

/* ── 分组框 ────────────────────────────────────────────────── */
QGroupBox {
    background-color: transparent;
    border: 1px solid #d4d6dc;
    border-radius: 5px;
    margin-top: 14px;
    padding: 8px 6px 4px 6px;
    font-weight: bold;
    font-size: 8.5pt;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 8px;
    color: #505060;
    font-weight: bold;
    background-color: #f2f3f5;
}

/* ── 设置页内联分区标题 ────────────────────────────────────── */
QLabel#settingsSection {
    color: #707080;
    font-size: 8.5pt;
    font-weight: bold;
    padding: 4px 0px 2px 0px;
}

/* ── 分隔线 ────────────────────────────────────────────────── */
QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #d4d6dc;
}

/* ── 对话框 ────────────────────────────────────────────────── */
QDialog {
    background-color: #f2f3f5;
    color: #1e1e2e;
}

QMessageBox {
    background-color: #f2f3f5;
    color: #1e1e2e;
}
QMessageBox QLabel {
    color: #505060;
}
