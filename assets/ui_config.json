{
    "_FILE_COMMENT_0": "═" ,
    "_FILE_COMMENT_1": "ui_config.json — Llama.cpp 启动器 用户界面配置文件",
    "_FILE_COMMENT_2": "修改本文件可直接定制启动器的显示文字和界面行为，无需修改 Python 代码。",
    "_FILE_COMMENT_3": "修改后重启启动器即可生效。",
    "_FILE_COMMENT_4": "注意：JSON 标准不支持注释，因此用 _ 前缀的键模拟注释。",
    "_FILE_COMMENT_5": "可安全修改所有 value（text/tooltip/label/color 等），不要删除或重命名键。",
    "_FILE_COMMENT_6": "可用占位符 {name} {path} {error} {code} {count} {mode} {ngl} {free} {total} {err}",
    "_FILE_COMMENT_7": "═" ,

    "参数定义": {
        "_comment": "schema 数组定义动态生成的参数控件。每个 group 对应一个 CollapsibleSection 分组，类型支持 string/int/float/bool/combo/check。",
        "schema": [
            {
                "group_name": " 推理核心参数 (自动生成) ",
                "_comment": "模型推理的核心超参数。",
                "params": [
                    {"id": "ngl",            "label": "GPU 层数 (-ngl):",       "type": "string", "default": "auto",   "arg": "-ngl",            "width": 12, "tooltip": "GPU 卸载层数：auto=自动检测, all=全部, 或指定数字"},
                    {"id": "ctx",            "label": "上下文 (-c):",           "type": "int",    "default": 16384,    "arg": "-c",              "min": 512,   "max": 131072, "step": 512,  "width": 12, "tooltip": "上下文窗口大小（token 数），0=从模型读取"},
                    {"id": "temp",           "label": "温度 (--temp):",         "type": "float",  "default": 0.7,       "arg": "--temp",          "min": 0.0,   "max": 2.0,   "step": 0.05, "width": 10, "tooltip": "生成温度，越高越随机，默认 0.80"},
                    {"id": "rep_pen",        "label": "重复惩罚 (-rp):",        "type": "float",  "default": 1.1,       "arg": "--repeat-penalty", "min": 0.5,   "max": 2.0,   "step": 0.05, "width": 10, "tooltip": "重复惩罚系数，1.0=禁用"},
                    {"id": "threads",        "label": "CPU 线程 (-t):",         "type": "int",    "default": 8,         "arg": "-t",              "min": 1,     "max": 64,    "step": 1,    "width": 12, "tooltip": "CPU 并行线程数，默认 -1=自动"},
                    {"id": "tb",             "label": "批线程 (-tb):",          "type": "int",    "default": 1,         "arg": "-tb",             "min": 1,     "max": 64,    "step": 1,    "width": 12, "tooltip": "批处理线程数，默认同 --threads"},
                    {"id": "batch",          "label": "批大小 (-b):",           "type": "int",    "default": 512,       "arg": "-b",              "min": 1,     "max": 32768, "step": 128,  "width": 12, "tooltip": "逻辑最大批大小，默认 2048"},
                    {"id": "ubatch",         "label": "物理批 (-ub):",          "type": "int",    "default": 512,       "arg": "-ub",             "min": 1,     "max": 32768, "step": 128,  "width": 12, "tooltip": "物理最大批大小，默认 512"},
                    {"id": "min_p",          "label": "最低概率 (--min-p):",    "type": "float",  "default": 0.05,      "arg": "--min-p",         "min": 0.0,   "max": 1.0,   "step": 0.01, "width": 12, "tooltip": "min-p 采样，0.0=禁用"},
                    {"id": "top_p",          "label": "最高概率 (--top-p):",    "type": "float",  "default": 0.95,      "arg": "--top-p",         "min": 0.0,   "max": 1.0,   "step": 0.01, "width": 12, "tooltip": "top-p 核采样，1.0=禁用"},
                    {"id": "image_min_tokens","label": "图像最小 Token:",        "type": "string", "default": "",        "arg": "--image-min-tokens","width": 12, "tooltip": "多模态每张图像最小 token 数"},
                    {"id": "image_max_tokens","label": "图像最大 Token:",        "type": "string", "default": "",        "arg": "--image-max-tokens","width": 12, "tooltip": "多模态每张图像最大 token 数"}
                ]
            },
            {
                "group_name": " 投机解码 (--spec-type) ",
                "_comment": "投机解码参数：开启后可加速推理生成。",
                "params": [
                    {"id": "spec_type",      "label": "投机解码类型:",          "type": "combo",   "default": "none",  "arg": "--spec-type",      "width": 16, "tooltip": "none/draft-simple/draft-eagle3/draft-mtp/ngram-simple/ngram-map-k/ngram-map-k4v/ngram-mod/ngram-cache", "options": ["none","draft-simple","draft-eagle3","draft-mtp","ngram-simple","ngram-map-k","ngram-map-k4v","ngram-mod","ngram-cache"]},
                    {"id": "spec_draft_n_max","label": "Draft 最大 Token 数:",  "type": "int",    "default": 3,       "arg": "--spec-draft-n-max",  "min": 1, "max": 64, "step": 1, "width": 12, "tooltip": "投机解码每轮最大 draft token 数"},
                    {"id": "spec_ngram_n_min",  "label": "Ngram-Mod 最小 N:",    "type": "int",    "default": 48,      "arg": "--spec-ngram-mod-n-min",  "min": 1, "max": 1024, "step": 1, "width": 12, "tooltip": "ngram 投机解码使用的最小 ngram token 数"},
                    {"id": "spec_ngram_n_max",  "label": "Ngram-Mod 最大 N:",    "type": "int",    "default": 64,      "arg": "--spec-ngram-mod-n-max",  "min": 1, "max": 1024, "step": 1, "width": 12, "tooltip": "ngram 投机解码使用的最大 ngram token 数"},
                    {"id": "spec_ngram_n_match","label": "Ngram-Mod 查找长度:",   "type": "int",    "default": 24,      "arg": "--spec-ngram-mod-n-match","min": 1,"max": 256, "step": 1, "width": 12, "tooltip": "ngram-mod 查找长度"}
                ]
            },
            {
                "group_name": " 显存与去重优化 ",
                "_comment": "KV Cache 压缩、DRY 去重、显存优化选项。",
                "params": [
                    {"id": "cache_k",    "label": "Cache K 类型:",       "type": "string", "default": "",      "arg": "--cache-type-k",    "width": 12, "tooltip": "K Cache 数据类型: f32/f16/bf16/q8_0/q4_0 等，留空=默认 f16"},
                    {"id": "cache_v",    "label": "Cache V 类型:",       "type": "string", "default": "",      "arg": "--cache-type-v",    "width": 12, "tooltip": "V Cache 数据类型: f32/f16/bf16/q8_0/q4_0 等，留空=默认 f16"},
                    {"id": "dry_mult",   "label": "DRY 乘数:",           "type": "float",  "default": 0.8,   "arg": "--dry-multiplier", "min": 0.0,   "max": 5.0,   "step": 0.1,  "width": 12, "tooltip": "DRY 采样乘数，0.0=禁用"},
                    {"id": "dry_base",   "label": "DRY 基础:",           "type": "float",  "default": 1.75,  "arg": "--dry-base",       "min": 0.0,   "max": 10.0,  "step": 0.05, "width": 12, "tooltip": "DRY 采样基础值，默认 1.75"},
                    {"id": "dry_len",    "label": "DRY 允许长度:",       "type": "int",    "default": 2,     "arg": "--dry-allowed-length","min": 0,   "max": 100,   "step": 1,    "width": 12, "tooltip": "DRY 允许的最大重复 token 长度，默认 2"},
                    {"id": "flash_attn", "label": "Flash-Attn:",         "type": "check",  "default": true,  "arg": "--flash-attn",     "width": 8, "tooltip": "Flash Attention 加速，取消勾选可禁用 FA", "checked_val": "on", "unchecked_val": "off"},
                    {"id": "no_mmap",    "label": "禁用 MMAP:",          "type": "bool",   "default": false, "arg": "--no-mmap",        "bool_val": "", "tooltip": "禁用内存映射加载（更慢但可能减少 pageout）"},
                    {"id": "mlock",      "label": "锁定内存:",           "type": "bool",   "default": false, "arg": "--mlock",          "bool_val": "", "tooltip": "强制模型常驻物理 RAM，防止被 swap"},
                    {"id": "cmoe",       "label": "专家常驻 (-cmoe):",   "type": "bool",   "default": false, "arg": "-cmoe",           "bool_val": "", "tooltip": "MoE 所有专家权重保留在 GPU"},
                    {"id": "ncmoe",      "label": "内存专家层数:",       "type": "string", "default": "",     "arg": "-ncmoe",          "width": 12, "tooltip": "前 N 层 MoE 专家权重保留在 CPU"},
                    {"id": "fit",        "label": "显存自适应:",         "type": "check",  "default": true,  "arg": "--fit",           "width": 8, "tooltip": "显存自适应分配 (取消勾选可避免额外显存开销)", "checked_val": "on", "unchecked_val": "off"}
                ]
            }
        ],
        "ui_sections": [
            {
                "_comment": "运行模式与端口 — type 支持：checkbox/label/text/radio/file/button。radio 用 group 分组互斥。",
                "group_name": " 运行与附加参数 ",
                "controls": [
                    {"id": "is_server_mode", "type": "checkbox", "label": "Server (API) 模式", "default": false},
                    {"id": "port_label",     "type": "label",    "text": "端口:", "new_row": false},
                    {"id": "port",           "type": "text",     "default": "8080", "width": 80, "config_key": "last_port", "new_row": false},
                    {"id": "console_mode",   "type": "checkbox", "label": "外部控制台", "default": false, "new_row": false},
                    {"id": "auto_open_browser", "type": "checkbox", "label": "自动打开浏览器", "default": true, "new_row": false},
                    {"id": "mode_label", "type": "label", "text": "", "new_row": false}
                ]
            },
            {
                "group_name": " 思考控制与多模态 ",
                "controls": [
                    {"id": "think_normal", "type": "radio",   "label": "正常输出", "group": "think_mode", "value": "normal"},
                    {"id": "think_hide",   "type": "radio",   "label": "完全隐藏", "group": "think_mode", "value": "hide", "new_row": false},
                    {"id": "think_budget", "type": "text",    "label": "思考 Token 限制:", "default": "0"},
                    {"id": "mmproj_cb",    "type": "checkbox","label": "启用", "default": false, "config_key": "mmproj_enable"},
                    {"id": "mmproj",       "type": "file",    "label": "MMProj 文件:", "default": "", "enable_by": "mmproj_cb", "new_row": false},
                    {"id": "draft_cb",     "type": "checkbox","label": "启用", "default": false, "config_key": "model_draft_enable"},
                    {"id": "model_draft",  "type": "file",    "label": "Draft 模型:", "default": "", "enable_by": "draft_cb", "new_row": false}
                ]
            },
            {
                "group_name": " 额外参数 ",
                "controls": [
                    {"id": "global_args",  "type": "text",    "label": "全局默认参数:",   "default": "", "placeholder": "--no-warmup --cont-batching", "new_row": false},
                    {"id": "custom_args",  "type": "text",    "label": "当前模型专属参数:", "default": "", "placeholder": "--special-token ...", "new_row": false}
                ]
            }
        ]
    },

